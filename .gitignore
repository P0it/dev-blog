# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp temp
.playwright-mcp/
.env*.local

# 콘텐츠 백업 덤프(기본 위치). 오프사이트 백업은 별도 비공개 레포로.
/backups/

# Claude Code 직접 경로 작업 파일(.md 초안 임시본). docs/draft-in-claude-code.md 참고.
/drafts/

# Claude Code 로컬 설정/권한 (개인 환경) — commands/ 는 공유하므로 커밋한다.
# agents·skills·scripts·.claude-plugin 은 레포에 넣은 humanize-korean(클라우드 루틴도 쓰게).
/.claude/*
!/.claude/commands/
!/.claude/agents/
!/.claude/skills/
!/.claude/scripts/
!/.claude/.claude-plugin/
# humanize-korean 스킬이 cwd 에 만드는 작업 폴더
/_workspace/

# 브레인스토밍 시각 도구 세션 파일
.superpowers/
__pycache__/
