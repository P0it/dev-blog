    "def can_finish(piles, speed, h):",
    "    hours = 0",
    "    for p in piles:",
    "        hours += (p + speed - 1) // speed",
    "    return hours <= h",
    "",
    "def min_speed(piles, h):",
    "    lo, hi = 1, max(piles)",
    "    while lo < hi:",
    "        mid = (lo + hi) // 2",
    "        if can_finish(piles, mid, h):",
    "            hi = mid",
    "        else:",
    "            lo = mid + 1",
    "    return lo"
