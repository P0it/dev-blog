{
  "code": [
    "def dfs(grid, start, goal):",
    "    rows, cols = len(grid), len(grid[0])",
    "    stack = [start]",
    "    dist = {start: 0}",
    "    while stack:",
    "        r, c = stack.pop()",
    "        if (r, c) == goal:",
    "            return dist[(r, c)]",
    "        for dr, dc in ((-1,0),(1,0),(0,-1),(0,1)):",
    "            nr, nc = r + dr, c + dc",
    "            if not (0 <= nr < rows and 0 <= nc < cols):",
    "                continue",
    "            if grid[nr][nc] == 0 and (nr, nc) not in dist:",
    "                dist[(nr, nc)] = dist[(r, c)] + 1",
    "                stack.append((nr, nc))",
    "    return -1"
  ],
