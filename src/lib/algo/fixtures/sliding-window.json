  "code": [
    "def max_window_sum(arr, k):",
    "    n = len(arr)",
    "    window = sum(arr[:k])",
    "    best = window",
    "    for i in range(k, n):",
    "        window += arr[i] - arr[i - k]",
    "        best = max(best, window)",
    "    return best"
