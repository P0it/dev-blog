{
  "code": [
    "def best_pack(weights, values, limit):",
    "    n = len(weights)",
    "    best = 0",
    "    for mask in range(2 ** n):",
    "        w = v = 0",
    "        for i in range(n):",
    "            if mask >> i & 1:",
    "                w += weights[i]",
    "                v += values[i]",
    "        if w <= limit and v > best:",
    "            best = v",
    "    return best"
