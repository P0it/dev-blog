  "code": [
    "def best_pack(weights, values, limit):",
    "    n = len(weights)",
    "    best = 0",
    "    for mask in range(2 ** n):",
    "        w = sum(weights[i] for i in range(n) if mask >> i & 1)",
    "        v = sum(values[i] for i in range(n) if mask >> i & 1)",
    "        if w <= limit and v > best:",
    "            best = v",
    "    return best"
