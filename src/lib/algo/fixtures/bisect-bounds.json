{
  "leftCode": [
    "def bisect_left(arr, x):",
    "    lo, hi = 0, len(arr)",
    "    while lo < hi:",
    "        mid = (lo + hi) // 2",
    "        if arr[mid] < x:",
    "            lo = mid + 1",
    "        else:",
    "            hi = mid",
    "    return lo"
  ],
  "rightCode": [
    "def bisect_right(arr, x):",
    "    lo, hi = 0, len(arr)",
    "    while lo < hi:",
    "        mid = (lo + hi) // 2",
    "        if arr[mid] <= x:",
    "            lo = mid + 1",
    "        else:",
    "            hi = mid",
    "    return lo"
  ],
