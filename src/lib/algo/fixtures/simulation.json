{
  "code": [
    "def robot(commands, grid, r, c):",
    "    rows, cols = len(grid), len(grid[0])",
    "    dr = [-1, 0, 1, 0]",
    "    dc = [0, 1, 0, -1]",
    "    d = 0",
    "    for cmd in commands:",
    "        if cmd == \"F\":",
    "            nr, nc = r + dr[d], c + dc[d]",
    "            if 0 <= nr < rows and 0 <= nc < cols and grid[nr][nc] == 0:",
    "                r, c = nr, nc",
    "        elif cmd == \"R\":",
    "            d = (d + 1) % 4",
    "        else:",
    "            d = (d - 1) % 4",
    "    return r, c"
  ],
