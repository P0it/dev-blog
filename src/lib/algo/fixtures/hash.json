    "def build_and_find(names, target):",
    "    buckets = [[] for _ in range(8)]",
    "    for name in names:",
    "        slot = sum(ord(c) for c in name) % 8",
    "        buckets[slot].append(name)",
    "    slot = sum(ord(c) for c in target) % 8",
    "    for who in buckets[slot]:",
    "        if who == target:",
    "            return True",
    "    return False"
