{
  "code": [
    "def quick_sort(arr, lo, hi):",
    "    if lo >= hi:",
    "        return",
    "    pivot = arr[lo]",
    "    i = lo",
    "    for j in range(lo + 1, hi + 1):",
    "        if arr[j] < pivot:",
    "            i += 1",
    "            arr[i], arr[j] = arr[j], arr[i]",
    "    arr[lo], arr[i] = arr[i], arr[lo]",
    "    quick_sort(arr, lo, i - 1)",
    "    quick_sort(arr, i + 1, hi)"
  ],
